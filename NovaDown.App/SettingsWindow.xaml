<Window x:Class="NovaDown.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovaDown 设置" Height="600" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="下载" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="下载目录"/>
            <Grid Margin="0,2,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DirBox" Padding="4,4" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="浏览…" Margin="6,0,0,0" Padding="10,4" Click="Browse_Click"/>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="全局速度上限" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SpeedCombo" Grid.Column="1" SelectedIndex="0">
                    <ComboBoxItem Content="不限速" Tag="0"/>
                    <ComboBoxItem Content="512 KB/s" Tag="524288"/>
                    <ComboBoxItem Content="1 MB/s" Tag="1048576"/>
                    <ComboBoxItem Content="2 MB/s" Tag="2097152"/>
                    <ComboBoxItem Content="5 MB/s" Tag="5242880"/>
                    <ComboBoxItem Content="10 MB/s" Tag="10485760"/>
                </ComboBox>
                <TextBlock Grid.Column="2" Text="单任务分段数" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <TextBox x:Name="SegmentsBox" Grid.Column="3" Padding="4,4" VerticalContentAlignment="Center"/>
            </Grid>
            <CheckBox x:Name="AutoStartCheck" Content="新任务自动开始下载" Margin="0,0,0,4"/>

            <TextBlock Text="接管服务（浏览器扩展 / Agent 插件）" FontSize="14" FontWeight="Bold" Margin="0,16,0,8"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="API 端口" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="PortBox" Grid.Column="1" Padding="4,4" Width="90"
                         HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="访问令牌" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <DockPanel Grid.Column="3" Width="230">
                    <Button DockPanel.Dock="Right" Content="复制" Padding="10,4" Margin="6,0,0,0" Click="CopyToken_Click"/>
                    <TextBox x:Name="TokenBox" IsReadOnly="True" Padding="4,4" FontSize="11"
                             VerticalContentAlignment="Center"/>
                </DockPanel>
            </Grid>
            <CheckBox x:Name="TakeoverCheck" Content="启用浏览器接管（桌面端总开关）" Margin="0,4,0,4"/>
            <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="最小接管大小(MB)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="MinSizeBox" Grid.Column="1" Padding="4,4" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="接管扩展名(逗号分隔)" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <TextBox x:Name="ExtensionsBox" Grid.Column="3" Padding="4,4" VerticalContentAlignment="Center"/>
            </Grid>
            <CheckBox x:Name="FallbackCheck" Content="NovaDown 出错时回退为浏览器普通下载" Margin="0,4,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" Padding="20,6" Margin="0,0,8,0" Click="Save_Click" IsDefault="True"/>
                <Button Content="取消" Padding="20,6" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
