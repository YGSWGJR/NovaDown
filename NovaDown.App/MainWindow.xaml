<Window x:Class="NovaDown.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovaDown 下载器" Height="540" Width="880"
        MinHeight="440" MinWidth="680">
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="下载链接:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="UrlBox" Width="440" VerticalAlignment="Center"
                         Padding="4,6" TextChanged="UrlBox_TextChanged"/>
                <Button x:Name="AddButton" Content="添加任务" Margin="8,0,0,0" Padding="16,6"
                        IsEnabled="False" Click="AddButton_Click"/>
            </StackPanel>
            <Button x:Name="SettingsButton" Grid.Column="1" Content="⚙ 设置"
                    Padding="14,6" Click="SettingsButton_Click"/>
        </Grid>

        <DockPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ApiStatusText" VerticalAlignment="Center"
                       FontSize="11" Foreground="#666"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="PauseButton" Content="暂停" Padding="16,6"
                        Margin="0,0,8,0" IsEnabled="False" Click="PauseButton_Click"/>
                <Button x:Name="ResumeButton" Content="继续" Padding="16,6"
                        Margin="0,0,8,0" IsEnabled="False" Click="ResumeButton_Click"/>
                <Button x:Name="OpenFolderButton" Content="打开所在目录" Padding="16,6"
                        IsEnabled="False" Click="OpenFolderButton_Click"/>
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="TaskGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" ItemsSource="{Binding Tasks}"
                  SelectionChanged="TaskGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="2*"/>
                <DataGridTemplateColumn Header="进度" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center">
                                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="6"/>
                                <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center"
                                           FontSize="10" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="已下载 / 大小" Binding="{Binding SizeText}" Width="170"/>
                <DataGridTextColumn Header="速度" Binding="{Binding SpeedText}" Width="110"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
